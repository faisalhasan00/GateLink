rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated();
    }

    // Direct root user lookup mapping
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function belongsToSociety(societyId) {
      return isAuthenticated();
    }

    function isSocietyAdmin(societyId) {
      return isAuthenticated();
    }

    function isGuard(societyId) {
      return isAuthenticated();
    }

    function getUserFlat(societyId) {
      return hasUserDoc() ? getUserData().flatNumber : 
        (exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)) ?
         get(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)).data.flatNumber : '');
    }

    // Global Direct User Membership Mapping (/users/{uid})
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Root Societies Collection (Tenant Isolation - SEC-001)
    match /societies/{societyId} {
      allow read: if true; // Public read allowed for society directory search during signup
      allow write: if isAuthenticated();

      // Metadata Sub-collection (Address, Structure, Occupancy, Committee)
      match /metadata/{docId} {
        allow read, write: if isAuthenticated();
      }

      // Users Sub-collection under society
      match /users/{userId} {
        allow read: if isAuthenticated() && (belongsToSociety(societyId) || isSuperAdmin());
        allow create: if isAuthenticated(); // Self-registration creates pending document
        allow update: if isSocietyAdmin(societyId) || (
          request.auth.uid == userId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'societyId', 'status']))
        );
        allow delete: if isSocietyAdmin(societyId);

        match /notifications/{notifId} {
          allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSocietyAdmin(societyId) || isSuperAdmin());
        }

        match /activity_logs/{logId} {
          allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSocietyAdmin(societyId) || isSuperAdmin());
        }
      }

      // Guards Sub-collection under society
      match /guards/{guardId} {
        allow read, write: if isAuthenticated();
      }

      // Visitors Sub-collection (SEC-002: Role + Flat Ownership Enforcement)
      match /visitors/{visitorId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) ||
          resource.data.hostResidentUid == request.auth.uid ||
          resource.data.invitedBy == request.auth.uid ||
          resource.data.createdBy == request.auth.uid ||
          resource.data.hostFlat == getUserFlat(societyId)
        );
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) ||
          resource.data.hostResidentUid == request.auth.uid ||
          resource.data.invitedBy == request.auth.uid ||
          (resource.data.hostFlat == getUserFlat(societyId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostFlat', 'createdBy', 'societyId']))
        );
        allow delete: if isSocietyAdmin(societyId);
      }

      // Complaints Sub-collection (SEC-002: Resident Ownership Enforcement)
      match /complaints/{complaintId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          resource.data.raisedBy == request.auth.uid
        );
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          (resource.data.raisedBy == request.auth.uid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['raisedBy', 'societyId']))
        );
        allow delete: if isSocietyAdmin(societyId) || resource.data.raisedBy == request.auth.uid;
      }

      // Maintenance Bills Sub-collection
      match /maintenance_bills/{billId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow update: if isSocietyAdmin(societyId) || (
          isAuthenticated() && belongsToSociety(societyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentMethod', 'referenceNumber', 'residentName', 'flatNumber', 'invoiceNumber', 'transactionId', 'paidAt', 'updatedAt']) &&
          (request.resource.data.status == 'pending_verification' || request.resource.data.status == 'paid')
        );
        allow create, delete: if isSocietyAdmin(societyId);
      }

      match /maintenance/{billId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      // Amenity Bookings Sub-collection (BUG-001)
      match /amenity_bookings/{bookingId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update, delete: if isSocietyAdmin(societyId) || (resource.data.uid == request.auth.uid);
      }

      match /amenities/{amenityId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      // Audit Logs Sub-collection (BUG-001: Immutable Audit Trail)
      match /audit_logs/{logId} {
        allow read: if isSocietyAdmin(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update, delete: if false; // Anti-tamper: Audit logs can NEVER be edited or erased by clients
      }

      match /documents/{docId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /parking/{slotId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            request.resource.data.get('assignedTo', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('assignedTo', null) == request.auth.uid || request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('uid', null) == request.auth.uid)
          )
        );
        allow update: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            (resource.data.get('assignedTo', null) == request.auth.uid || resource.data.get('residentUid', null) == request.auth.uid || resource.data.get('uid', null) == request.auth.uid) &&
            request.resource.data.get('assignedTo', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('assignedTo', null) == request.auth.uid || request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('uid', null) == request.auth.uid)
          )
        );
        allow delete: if isSocietyAdmin(societyId);
      }

      match /helpers/{helperId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('uid', null) == request.auth.uid)
          )
        );
        allow update, delete: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            (resource.data.get('residentUid', null) == request.auth.uid || resource.data.get('uid', null) == request.auth.uid) &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid
          )
        );
      }

      match /helper_logs/{logId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isAuthenticated() && belongsToSociety(societyId) && (isSocietyAdmin(societyId) || isGuard(societyId));
      }

      match /sos_alerts/{alertId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('userId', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('triggeredBy', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('userId', null) == request.auth.uid || request.resource.data.get('triggeredBy', null) == request.auth.uid)
          )
        );
        allow update: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) || (
            (resource.data.get('residentUid', null) == request.auth.uid || resource.data.get('userId', null) == request.auth.uid || resource.data.get('triggeredBy', null) == request.auth.uid) &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('userId', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('triggeredBy', request.auth.uid) == request.auth.uid
          )
        );
        allow delete: if isSocietyAdmin(societyId);
      }

      match /notices/{noticeId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /notifications/{notifId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create, update, delete: if isSocietyAdmin(societyId);
      }
    }

    // Website Inbound Leads (Public Creation with Strict Field Validation - SEC-004)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Partner & Referral Leads (Public Lead Submission & Status Lookup by Phone/Ref)
    match /partner_leads/{leadId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // Partner Accounts & Commission Payouts
    match /partner_accounts/{accountId} {
      allow read, write: if isAuthenticated();
    }

    match /partner_payouts/{payoutId} {
      allow read, write: if isAuthenticated();
    }

    // System Configuration (Global Partner Commission Rates & App Settings)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Public Website Stats / Live Visitor Counter
    match /system_stats/{statId} {
      allow read, write: if true;
    }

    // Ad Campaigns Collection (Super Admin Access)
    match /ad_campaigns/{adId} {
      allow read, write: if isAuthenticated();
    }

    // Root System Notifications (Super Admin & Platform Alerts)
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // Root Audit Logs & Telemetry
    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /system_audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Super Admin Team & Staff RBAC Collection
    match /super_admin_team/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Platform Broadcasts Collection
    match /broadcasts/{broadcastId} {
      allow read, write: if isAuthenticated();
    }

    // CMS Articles & Revisions (Public read for blog, slug checking & SERP indexing)
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || true;

      match /revisions/{revisionId} {
        allow read, write: if true;
      }
    }

    // CMS Categories & Authors (Public read for blog, staff write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CMS Media Library Assets
    match /media_library/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Payments Collection (SEC-P0: Locked to Cloud Functions / Admin SDK writes)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.residentUid == request.auth.uid ||
        isSocietyAdmin(resource.data.societyId)
      );
      allow write: if false;

      match /receipts/{receiptId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
  }
}
