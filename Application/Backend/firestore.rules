rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.keys().hasAll(['role']) &&
        request.auth.token.role == 'super_admin';
    }

    // Direct root user lookup mapping
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function belongsToSociety(societyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)) ||
        (hasUserDoc() && getUserData().societyId == societyId)
      );
    }

    function isSocietyAdmin(societyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          belongsToSociety(societyId) &&
          (
            (exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)).data.role == 'admin') ||
            (hasUserDoc() && getUserData().role == 'admin')
          )
        )
      );
    }

    function isGuard(societyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          belongsToSociety(societyId) &&
          (
            (exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)).data.role == 'guard') ||
            (hasUserDoc() && getUserData().role == 'guard')
          )
        )
      );
    }

    function getUserFlat(societyId) {
      return hasUserDoc() ? getUserData().flatNumber : 
        (exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)) ?
         get(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)).data.flatNumber : '');
    }

    // Global Direct User Membership Mapping (/users/{uid})
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Root Societies Collection (Tenant Isolation - SEC-001)
    match /societies/{societyId} {
      allow read: if true; // Public read allowed for society directory search during signup
      allow write: if isSuperAdmin();

      // Users Sub-collection under society
      match /users/{userId} {
        allow read: if isAuthenticated() && (belongsToSociety(societyId) || isSuperAdmin());
        allow create: if isAuthenticated(); // Self-registration creates pending document
        allow update: if isSocietyAdmin(societyId) || (
          request.auth.uid == userId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'societyId', 'status']))
        );
        allow delete: if isSocietyAdmin(societyId);

        match /notifications/{notifId} {
          allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSocietyAdmin(societyId) || isSuperAdmin());
        }
      }

      // Visitors Sub-collection (SEC-002: Role + Flat Ownership Enforcement)
      match /visitors/{visitorId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) ||
          resource.data.hostFlat == getUserFlat(societyId) ||
          resource.data.createdBy == request.auth.uid
        );
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) ||
          (resource.data.hostFlat == getUserFlat(societyId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostFlat', 'createdBy', 'societyId']))
        );
        allow delete: if isSocietyAdmin(societyId);
      }

      // Complaints Sub-collection (SEC-002: Resident Ownership Enforcement)
      match /complaints/{complaintId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          resource.data.raisedBy == request.auth.uid
        );
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          (resource.data.raisedBy == request.auth.uid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['raisedBy', 'societyId']))
        );
        allow delete: if isSocietyAdmin(societyId) || resource.data.raisedBy == request.auth.uid;
      }

      // Maintenance Bills Sub-collection
      match /maintenance_bills/{billId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow update: if isSocietyAdmin(societyId) || (
          isAuthenticated() && belongsToSociety(societyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentMethod', 'referenceNumber', 'residentName', 'flatNumber', 'invoiceNumber', 'updatedAt']) &&
          request.resource.data.status == 'pending_verification'
        );
        allow create, delete: if isSocietyAdmin(societyId);
      }

      match /maintenance/{billId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      // Amenity Bookings Sub-collection (BUG-001)
      match /amenity_bookings/{bookingId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update, delete: if isSocietyAdmin(societyId) || (resource.data.uid == request.auth.uid);
      }

      match /amenities/{amenityId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      // Audit Logs Sub-collection (BUG-001: Immutable Audit Trail)
      match /audit_logs/{logId} {
        allow read: if isSocietyAdmin(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update, delete: if false; // Anti-tamper: Audit logs can NEVER be edited or erased by clients
      }

      match /documents/{docId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /parking/{slotId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /notices/{noticeId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }
    }

    // Website Inbound Leads (Public Creation with Strict Field Validation - SEC-004)
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone']) &&
                       request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.name.size() < 200 &&
                       (!request.resource.data.keys().hasAny(['status', 'assignedTo', 'internalNotes']));
      allow read, update, delete: if isSuperAdmin();
    }

    // Ad Campaigns Collection (Super Admin Access)
    match /ad_campaigns/{adId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Payments Collection (SEC-P0: Locked to Cloud Functions / Admin SDK writes)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.residentUid == request.auth.uid ||
        isSocietyAdmin(resource.data.societyId)
      );
      allow write: if false;

      match /receipts/{receiptId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
  }
}
