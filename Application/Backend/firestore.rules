rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'super_admin' ||
        (hasUserDoc() && getUserData().get('role', '') == 'super_admin')
      );
    }

    // Direct root user lookup mapping
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        !hasUserDoc() ||
        (getUserData().get('status', 'active') in ['active', 'approved', ''])
      );
    }

    function belongsToSociety(societyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserDoc() && getUserData().get('societyId', '') == societyId) ||
        exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid))
      );
    }

    function isActiveResident(societyId) {
      return belongsToSociety(societyId) && (
        !hasUserDoc() ||
        (getUserData().get('role', 'resident') in ['resident', 'owner', 'tenant', 'family', 'user'])
      );
    }

    function isSocietyAdmin(societyId) {
      return isAuthenticated() && (
        (belongsToSociety(societyId) && (
          (hasUserDoc() && getUserData().get('role', '') in ['admin', 'society_admin']) ||
          (exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'society_admin'])
        )) ||
        isSuperAdmin()
      );
    }

    function isGuard(societyId) {
      return isApprovedUser() && belongsToSociety(societyId) && (
        (getUserData().get('role', '') in ['guard', 'security']) ||
        (exists(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/societies/$(societyId)/users/$(request.auth.uid)).data.get('role', '') in ['guard', 'security']) ||
        exists(/databases/$(database)/documents/societies/$(societyId)/guards/$(request.auth.uid))
      );
    }

    function getUserFlat(societyId) {
      return hasUserDoc() && ('flatNumber' in getUserData()) ? getUserData().flatNumber : '';
    }

    // Global Direct User Membership Mapping (/users/{uid})
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource.data.get('societyId', '') != '' && isSocietyAdmin(resource.data.get('societyId', '')))
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.get('role', 'resident') != 'super_admin'
        ) ||
        (
          request.resource.data.get('societyId', '') != '' &&
          isSocietyAdmin(request.resource.data.get('societyId', '')) &&
          request.resource.data.get('role', 'resident') != 'super_admin'
        )
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'societyId', 'status'])
        ) ||
        (
          resource.data.get('societyId', '') != '' &&
          isSocietyAdmin(resource.data.get('societyId', '')) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['societyId']) &&
          request.resource.data.get('role', resource.data.get('role', '')) != 'super_admin' &&
          (request.auth.uid != userId || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        )
      );

      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource.data.get('societyId', '') != '' &&
          isSocietyAdmin(resource.data.get('societyId', '')) &&
          request.auth.uid != userId
        )
      );
    }

    // Root Societies Collection (Tenant Isolation - SEC-001)
    match /societies/{societyId} {
      allow read: if true; // Public read allowed for society directory search during signup
      allow write: if isSocietyAdmin(societyId) || isSuperAdmin();

      // Metadata Sub-collection (Address, Structure, Occupancy, Bank Details)
      match /metadata/{docId} {
        allow read: if isAuthenticated() && (belongsToSociety(societyId) || isSuperAdmin());
        allow create, update, delete: if isSocietyAdmin(societyId) || isSuperAdmin();
      }

      // Users Sub-collection under society
      match /users/{userId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          belongsToSociety(societyId) ||
          isSocietyAdmin(societyId) ||
          isSuperAdmin()
        );

        allow create: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            isSocietyAdmin(societyId) &&
            request.resource.data.get('role', 'resident') != 'super_admin'
          ) ||
          (
            request.auth.uid == userId &&
            request.resource.data.get('societyId', societyId) == societyId &&
            !(request.resource.data.get('role', 'resident') in ['super_admin', 'society_admin', 'admin'])
          )
        );

        allow update: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            request.auth.uid == userId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'societyId', 'status'])
          ) ||
          (
            isSocietyAdmin(societyId) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['societyId']) &&
            request.resource.data.get('role', resource.data.get('role', '')) != 'super_admin' &&
            (request.auth.uid != userId || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
          )
        );

        allow delete: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            isSocietyAdmin(societyId) &&
            request.auth.uid != userId
          )
        );

        match /notifications/{notifId} {
          allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSocietyAdmin(societyId) || isSuperAdmin());
        }

        match /activity_logs/{logId} {
          allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSocietyAdmin(societyId) || isSuperAdmin());
        }
      }

      // Guards Sub-collection under society
      match /guards/{guardId} {
        allow read: if isAuthenticated() && (belongsToSociety(societyId) || isSuperAdmin());
        allow create, update, delete: if isSocietyAdmin(societyId) || isSuperAdmin();
      }

      // Visitors Sub-collection
      match /visitors/{visitorId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) ||
          isSuperAdmin() ||
          belongsToSociety(societyId)
        );
        allow create: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) ||
          isSuperAdmin() ||
          belongsToSociety(societyId)
        );
        allow update: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) ||
          isSuperAdmin() ||
          belongsToSociety(societyId)
        );
        allow delete: if isSocietyAdmin(societyId) || isSuperAdmin();
      }

      // Complaints Sub-collection
      match /complaints/{complaintId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isSuperAdmin() ||
          belongsToSociety(societyId)
        );
        allow create: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isSuperAdmin() ||
          (
            belongsToSociety(societyId) &&
            request.resource.data.get('societyId', societyId) == societyId
          )
        );
        allow update: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isSuperAdmin() ||
          belongsToSociety(societyId)
        );
        allow delete: if isSocietyAdmin(societyId) || isSuperAdmin() ||
          (belongsToSociety(societyId) && resource.data.get('raisedBy', '') == request.auth.uid);
      }

      // Maintenance Bills Sub-collection
      match /maintenance_bills/{billId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isSuperAdmin() ||
          belongsToSociety(societyId)
        );
        allow update: if isSocietyAdmin(societyId) || isSuperAdmin() || (
          belongsToSociety(societyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentMethod', 'referenceNumber', 'utrNumber', 'transactionId', 'residentName', 'flatNumber', 'invoiceNumber', 'submittedAt', 'updatedAt']) &&
          request.resource.data.status == 'pending_verification'
        );
        allow create, delete: if isSocietyAdmin(societyId) || isSuperAdmin();
      }

      match /maintenance/{billId} {
        allow read: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isSuperAdmin() ||
          belongsToSociety(societyId)
        );
        allow write: if isSocietyAdmin(societyId) || isSuperAdmin();
      }

      // Amenity Bookings Sub-collection (BUG-001)
      match /amenity_bookings/{bookingId} {
        allow read: if isAuthenticated() && (belongsToSociety(societyId) || isSuperAdmin());
        allow create: if isAuthenticated() && (
          isSocietyAdmin(societyId) ||
          isSuperAdmin() ||
          (isActiveResident(societyId) && request.resource.data.get('uid', request.auth.uid) == request.auth.uid)
        );
        allow update, delete: if isSocietyAdmin(societyId) || isSuperAdmin() || (
          isActiveResident(societyId) && resource.data.get('uid', '') == request.auth.uid
        );
      }

      match /amenities/{amenityId} {
        allow read: if isAuthenticated() && (belongsToSociety(societyId) || isSuperAdmin());
        allow write: if isSocietyAdmin(societyId) || isSuperAdmin();
      }

      // Audit Logs Sub-collection (BUG-001: Immutable Audit Trail)
      match /audit_logs/{logId} {
        allow read: if isSocietyAdmin(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId);
        allow update, delete: if false; // Anti-tamper: Audit logs can NEVER be edited or erased by clients
      }

      match /documents/{docId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /parking/{slotId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            request.resource.data.get('assignedTo', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('assignedTo', null) == request.auth.uid || request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('uid', null) == request.auth.uid)
          )
        );
        allow update: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            (resource.data.get('assignedTo', null) == request.auth.uid || resource.data.get('residentUid', null) == request.auth.uid || resource.data.get('uid', null) == request.auth.uid) &&
            request.resource.data.get('assignedTo', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('assignedTo', null) == request.auth.uid || request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('uid', null) == request.auth.uid)
          )
        );
        allow delete: if isSocietyAdmin(societyId);
      }

      match /helpers/{helperId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('uid', null) == request.auth.uid)
          )
        );
        allow update, delete: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            (resource.data.get('residentUid', null) == request.auth.uid || resource.data.get('uid', null) == request.auth.uid) &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('uid', request.auth.uid) == request.auth.uid
          )
        );
        match /salary_records/{recordId} {
          allow read, write: if isAuthenticated() && (belongsToSociety(societyId) || isSocietyAdmin(societyId) || isSuperAdmin());
        }
      }

      match /helper_logs/{logId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isAuthenticated() && belongsToSociety(societyId) && (isSocietyAdmin(societyId) || isGuard(societyId));
      }

      match /sos_alerts/{alertId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) || (
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('userId', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('triggeredBy', request.auth.uid) == request.auth.uid &&
            (request.resource.data.get('residentUid', null) == request.auth.uid || request.resource.data.get('userId', null) == request.auth.uid || request.resource.data.get('triggeredBy', null) == request.auth.uid)
          )
        );
        allow update: if isAuthenticated() && belongsToSociety(societyId) && (
          isSocietyAdmin(societyId) ||
          isGuard(societyId) || (
            (resource.data.get('residentUid', null) == request.auth.uid || resource.data.get('userId', null) == request.auth.uid || resource.data.get('triggeredBy', null) == request.auth.uid) &&
            request.resource.data.get('residentUid', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('userId', request.auth.uid) == request.auth.uid &&
            request.resource.data.get('triggeredBy', request.auth.uid) == request.auth.uid
          )
        );
        allow delete: if isSocietyAdmin(societyId);
      }

      match /notices/{noticeId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /polls/{pollId} {
        allow read: if isAuthenticated() && (belongsToSociety(societyId) || isSocietyAdmin(societyId) || isSuperAdmin());
        allow create, delete: if isSocietyAdmin(societyId) || isSuperAdmin();
        allow update: if isAuthenticated() && (belongsToSociety(societyId) || isSocietyAdmin(societyId) || isSuperAdmin());

        match /votes/{voteId} {
          allow read, write: if isAuthenticated() && (belongsToSociety(societyId) || isSocietyAdmin(societyId) || isSuperAdmin());
        }
      }

      match /notifications/{notifId} {
        allow read: if isAuthenticated() && belongsToSociety(societyId);
        allow create, update, delete: if isSocietyAdmin(societyId);
      }
    }

    // Account Deletion Requests (Self-Service Deletion Queue & Audit - SEC-P0)
    match /account_deletion_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isSuperAdmin();
    }

    // Website Inbound Leads (Public Creation with Strict Admin Access)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Partner & Referral Leads (Public Lead Submission & Controlled Status Lookup)
    match /partner_leads/{leadId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Partner Accounts & Commission Payouts
    match /partner_accounts/{accountId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.get('partnerUid', '') == request.auth.uid ||
        request.auth.uid == accountId
      );
      allow write: if isSuperAdmin();
    }

    match /partner_payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.get('partnerUid', '') == request.auth.uid
      );
      allow write: if isSuperAdmin();
    }

    // System Configuration (Global Partner Commission Rates & App Settings)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Public Website Stats / Live Visitor Counter
    match /system_stats/{statId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Ad Campaigns Collection (Public/Resident Read + Super Admin Write)
    match /ad_campaigns/{adId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Root System Notifications (Super Admin & Platform Alerts)
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Root Audit Logs & Telemetry
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /system_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Super Admin Team & Staff RBAC Collection
    match /super_admin_team/{memberId} {
      allow read, write: if isSuperAdmin();
    }

    // Platform Broadcasts Collection
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // CMS Articles & Revisions (Public read for blog, slug checking & SERP indexing)
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();

      match /revisions/{revisionId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // CMS Categories & Authors (Public read & Super Admin CMS management)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /authors/{authorId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // CMS Media Library Assets
    match /media_library/{mediaId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Payments Collection (SEC-P0: Locked to Cloud Functions / Admin SDK writes)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.residentUid == request.auth.uid ||
        isSocietyAdmin(resource.data.societyId)
      );
      allow write: if false;

      match /receipts/{receiptId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
  }
}
